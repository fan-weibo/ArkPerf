    "dompurify": "3.4.15",
    "marked": "18.0.13",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "6.0.3",
    "vite": "^8.0.5",
    "vue-tsc": "^3.3.11"
  }
}
